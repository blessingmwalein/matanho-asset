# ──────────────────────────────────────────────────────────────────────────────
# Matanho Nexus: environment reference.
# Copy the relevant block into apps/api/.env and apps/web/.env.local.
# NEVER commit real values. .env files are gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ═══ apps/api/.env ═══════════════════════════════════════════════════════════
# Neon PostgreSQL. Use the POOLED connection string for the running app…
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# …and the DIRECT (non-pooled) string for migrations (Prisma `directUrl`).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="generate-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# HTTP
PORT=4000
# Comma-separated origins allowed to call the API directly (browser traffic goes via the Next proxy)
CORS_ORIGIN="http://localhost:3000"

# Document storage: local | s3 | db
#   local → apps/api/.storage (dev only; ephemeral on Render)
#   s3    → any S3-compatible private bucket (set S3_* below)
#   db    → bytes stored in PostgreSQL (fallback when no S3 is available)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Seed
SEED_DEMO_USERS="true"
# Password given to every demo user (see DEMO_CREDENTIALS.md). Leave unset to use the documented dev default.
DEMO_PASSWORD=""

# ═══ apps/web/.env.local ═════════════════════════════════════════════════════
# Server-side URL of the NestJS API (used by the Next.js proxy route handler)
API_URL="http://localhost:4000"
# Show one-click demo logins on /login (set to "false" for anything non-demo)
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"
