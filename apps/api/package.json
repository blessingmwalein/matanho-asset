{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "description": "Matanho Nexus NestJS API (modular monolith)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node dist/seed/index.js",
    "seed:reset": "node dist/seed/index.js --reset",
    "seed:build": "nest build && node dist/seed/index.js",
    "seed:build:reset": "nest build && node dist/seed/index.js --reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nexus/shared": "*",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
